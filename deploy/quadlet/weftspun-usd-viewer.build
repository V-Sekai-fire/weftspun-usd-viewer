#
# Builds usd_viewer_app from this repo's own Dockerfile, its own
# deploy unit apart from weftspun_studio's. RFD 0076 gives the app;
# RFD 0120 split it into its own repo, weftspun/weftspun-usd-viewer,
# synced to /opt/weftspun/weftspun-usd-viewer by
# weftspun-studio's own scripts/deploy-weftspun-quadlet.sh.

[Build]
ImageTag=localhost/weftspun-usd-viewer:latest
File=/opt/weftspun/weftspun-usd-viewer/Dockerfile
SetWorkingDirectory=file
# See weftspun-crdb.build: rootful Podman's bridge network cannot
# reach the internet on this host, needed here for `npm ci`.
Network=host
DNS=1.1.1.1
